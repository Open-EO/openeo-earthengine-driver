{
  "name": "@openeo/earthengine-driver",
  "version": "1.1.1-dev20260318",
  "stac_version": "1.0.0",
  "description": "An openEO driver for Google Earth Engine.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --trace-warnings src/server.js",
    "up": "pm2 startOrRestart ecosystem.config.cjs",
    "down": "pm2 stop openeo-earthengine-server",
    "undeploy": "pm2 delete openeo-earthengine-server",
    "sync": "node src/sync.js",
    "adduser": "node src/adduser.js",
    "deluser": "node src/deluser.js",
    "users": "node src/users.js",
    "stats": "node src/stats.js",
    "cleancache": "node src/cleancache.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles",
    "debug": "node --nolazy --inspect src/server.js",
    "lint": "eslint src/"
  },
  "author": "Matthias Mohr",
  "license": "Apache-2.0",
  "homepage": "http://openeo.org",
  "bugs": {
    "url": "https://github.com/Open-EO/openeo-earthengine-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-EO/openeo-earthengine-editor.git"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-n": "^16.6.2",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "pm2": "^7.0.4"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@google/earthengine": "^1.7.48",
    "@openeo/js-commons": "^1.5.0",
    "@openeo/js-processgraphs": "^1.4.1",
    "@seald-io/nedb": "^4.1.2",
    "ajv": "^6.12.6",
    "axios": "^1.6.5",
    "check-disk-space": "^3.4.0",
    "epsg-index": "^2.0.0",
    "express": "^5.1.0",
    "fs-extra": "^11.2.0",
    "geotiff": "^2.1.3",
    "image-size": "^2.0.4",
    "luxon": "^3.4.4",
    "proj4": "^2.10.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@google/earthengine": {
      "googleapis": "^149.0.0"
    },
    "pm2": {
      "chokidar": "^4.0.3"
    },
    "basic-ftp": "^6.2.3",
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1"
  }
}
